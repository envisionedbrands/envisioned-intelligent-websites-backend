{
  "$schema": "node_modules/wrangler/config-schema.json",
  // worker.ts wraps OpenNext's generated handler to add `scheduled` — see the
  // file header. Reverting to ".open-next/worker.js" disables the cron and
  // restores stock OpenNext behaviour.
  "main": "worker.ts",
  "name": "envisioned-intelligent-websites-backend",
  // The CRM engine tick + social publish tick. Was a GitHub Action; GitHub
  // throttles scheduled workflows, which stalls onboarding email.
  // NOTE: .github/workflows/crm-tick.yml still exists and does the same job.
  // Once this cron is confirmed firing, disable that workflow so the engine
  // is not ticked twice.
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  // Keep the workers.dev URL alive; add a custom-domain route here when you
  // claim one, e.g. { "pattern": "backend.yourdomain.com", "custom_domain": true }
  "workers_dev": true,
  "compatibility_date": "2026-05-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "envisioned-intelligent-websites-backend"
    },
    {
      "binding": "FRONTEND_WORKER",
      "service": "digital-home-frontend-starter"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  // Social media files (videos + carousel slides). Make the bucket public by
  // attaching a custom domain (e.g. media.yourdomain.com) and set
  // R2_PUBLIC_BASE below to match — Meta ingests by pulling that URL, and R2
  // egress is free.
  // DISABLED 2026-08-05: R2 is not enabled on this Cloudflare account, so
  // wrangler fails the whole deploy on this binding (API error 10042). Social
  // file upload throws a clear error without it (src/lib/social/upload.ts:29);
  // nothing else is affected. Re-enable R2 in the dashboard, then uncomment —
  // and set R2_PUBLIC_BASE below to the bucket's real public domain, which is
  // required for Meta to ingest media regardless.
  // "r2_buckets": [
  //   {
  //     "binding": "SOCIAL_MEDIA",
  //     "bucket_name": "social-media"
  //   }
  // ],
  "observability": {
    "enabled": true
  },
  // Non-secret env vars. Secrets (Supabase service role, Anthropic key, Resend key,
  // API_SECRET_KEY) are set via `wrangler secret put` after the first deploy.
  "vars": {
    "SUPABASE_URL": "https://aqylffhuzunpimrebgye.supabase.co",
    "SUPABASE_ANON_KEY": "sb_publishable_JumdNZ3GzN06G5oVgBR8_Q_SX8vdlbq",
    "NEXT_PUBLIC_SUPABASE_URL": "https://aqylffhuzunpimrebgye.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_JumdNZ3GzN06G5oVgBR8_Q_SX8vdlbq",
    "DIGITAL_HOME_URL": "https://home.envisioned.me",
    "NEXT_PUBLIC_DIGITAL_HOME_URL": "https://home.envisioned.me",
    "API_SIGNATURE_REQUIRED": "true",
    "API_REQUEST_SIGNATURE_TTL_SECONDS": "300",
    // R2 public base for social media assets. NOT yet claimed — social image
    // and video publishing will fail until this points at a real public
    // domain attached to the SOCIAL_MEDIA bucket.
    "R2_PUBLIC_BASE": "https://media.yourdomain.com"
  }
}
