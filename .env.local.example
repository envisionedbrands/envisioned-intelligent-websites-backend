# Supabase — same credentials as the Digital Home
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Digital Home API — the public-facing site's URL
DIGITAL_HOME_URL=http://localhost:3000
NEXT_PUBLIC_DIGITAL_HOME_URL=http://localhost:3000
API_SECRET_KEY=your-api-secret-key
API_SIGNATURE_REQUIRED=true
API_REQUEST_SIGNATURE_TTL_SECONDS=300
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key
# ── Digital Home Upgrade: CRM ────────────────────────────────────────────────
# Email sending (Resend — https://resend.com). Until this is set AND safe mode
# is switched off in /crm/settings, all lead emails are simulated, never sent.
RESEND_API_KEY=

# Resend webhook signing secret (svix) — created when you add a webhook in the
# Resend dashboard pointing at <backend>/api/crm/webhooks/resend
RESEND_WEBHOOK_SECRET=

# ── Digital Home Upgrade: Bookings (optional) ────────────────────────────────
# Cal.com webhook secret — the same value you enter when creating the webhook
# in Cal.com (Settings → Developer → Webhooks)
CALCOM_WEBHOOK_SECRET=
# ── Operator Upgrade: the brain ──────────────────────────────────────────────
# The Operator runs on whichever provider you point it at. Your Digital Home
# already needs ANTHROPIC_API_KEY for the content pipeline and the CRM
# copywriter, so by default the Operator uses that same key — nothing new to
# buy. Add OPENAI_API_KEY instead (or as well) only if you want the reasoning
# loop on OpenAI.
#
# ANTHROPIC_API_KEY=      # already in your .env.local from the original setup
# OPENAI_API_KEY=         # optional — only if running the loop on OpenAI

# Which provider the Operator's reasoning loop uses: 'anthropic' or 'openai'.
# Leave blank to auto-detect (OpenAI key wins if present, else Anthropic).
OPERATOR_PROVIDER=

# Override the model. Defaults: claude-opus-4-8 (anthropic), gpt-5.4 (openai).
OPERATOR_MODEL=

# Optional: point the OpenAI path at any OpenAI-compatible endpoint instead of
# api.openai.com (a proxy, a gateway, a self-hosted model).
AI_BASE_URL=

# ── Operator Upgrade: MCP bridge (optional track) ────────────────────────────
# No new secret. The bridge at /api/agent/mcp authenticates with your existing
# API_SECRET_KEY as a bearer token. If you don't want the bridge, delete
# src/app/api/agent/mcp/route.ts — nothing else references it.
